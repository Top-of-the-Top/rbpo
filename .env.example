# Copy to .env and fill in: cp .env.example .env
# .env is gitignored — never commit real values.

# PostgreSQL
# Host is the compose service name — the backend reaches it over vedu_internal.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vedu
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vedu

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
